# Copy this file to .env and fill it in. Never commit .env to GitHub.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Clinic settings (doctors, hours, prices, contacts, languages).
#   config/clinic.yaml                      your own copy (recommended)
#   config/clinic.generic.example.yaml      the generic 3-language clinic, as in n8n "Clinic - Booking bot"
CLINIC_CONFIG=config/clinic.yaml
# Instead of a file you may paste the whole YAML here (useful on Railway): CLINIC_CONFIG_YAML=...

# Fill the REPLACE_WITH_… placeholders of the config when every doctor uses the same calendar / approver
CALENDAR_ID=
APPROVER_CHAT_ID=

# SQLite database file (bookings, sessions, waitlist)
DATABASE_PATH=data/bot.sqlite3

# Google service account key (JSON). Leave empty for a DRY RUN without a real calendar.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# …or paste the whole JSON key into this variable instead (useful on Railway):
GOOGLE_SERVICE_ACCOUNT_JSON=

# English / Russian translations (only used when the clinic config has more than one language)
I18N_FILE=n8n/clinic-i18n.json

# Optional: webhook mode. Leave empty to use long polling (simplest).
# Example: https://bot.example.com  (the bot listens on PORT at /telegram)
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=8080

# How often reminders and rating requests are checked
REMINDER_INTERVAL_MINUTES=30
LOG_LEVEL=INFO
